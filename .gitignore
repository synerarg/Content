# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
# Alternate build output, for verifying a production build without clobbering
# the directory a running `next dev` is serving from. See next.config.ts.
/.next-build/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which carries no values and which README.md,
# DEPLOY.md and lib/supabase/env.ts all instruct you to copy. Caught by the
# blanket .env* rule above, it would be absent from a fresh clone.
!.env.local.example

# vercel
.vercel

# Machine-local Claude Code permissions. .claude/launch.json is shared config
# and is committed; this one is not.
.claude/settings.local.json

# typescript
*.tsbuildinfo
next-env.d.ts
