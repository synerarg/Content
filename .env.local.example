# Copy to .env.local and fill in.
#
# ---------------------------------------------------------------------------
# Supabase  (Phase 0)
# ---------------------------------------------------------------------------
# Local stack (`supabase start` prints these):
#   NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Hosted project: Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only, and CURRENTLY UNUSED — leave it empty.
#
# Nothing in the codebase reads it: every server-side write, including copying a
# generated background into Storage, runs as the signed-in user and passes RLS
# on its own. Filling it in adds an RLS-bypassing key to the deployment for no
# capability. Never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Claude  (Phase 3)
# ---------------------------------------------------------------------------
# Model: claude-sonnet-5 (structured outputs via output_config.format)
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Image generation  (Phase 4)
# ---------------------------------------------------------------------------
# Which provider to use: "google" or "fal". If unset, whichever key is present
# wins (Gemini first), so adding FAL_KEY later is enough to switch back.
IMAGE_PROVIDER=google

# Google Gemini — free tier, no credit card: aistudio.google.com/apikey
# 500 images/day on gemini-2.5-flash-image. Note the free tier allows Google to
# use content for training and limits commercial rights.
GEMINI_API_KEY=
# Optional override, e.g. gemini-3.1-flash-image
GEMINI_IMAGE_MODEL=

# fal.ai — paid, per megapixel. Endpoint: fal-ai/flux-2 (FLUX.2 [dev])
FAL_KEY=

# ---------------------------------------------------------------------------
# Deploying
# ---------------------------------------------------------------------------
# Every variable above except SUPABASE_SERVICE_ROLE_KEY must also be set in the
# Vercel project. Only the two NEXT_PUBLIC_ ones reach the browser; the rest are
# read exclusively from route handlers and server modules.
#
# There is no NEXT_PUBLIC_SITE_URL: the OAuth callback derives the public
# hostname from the request itself (see app/auth/callback/route.ts), so preview
# deployments work without a per-environment URL to keep in sync.
#
# See DEPLOY.md for the Supabase and Google Cloud settings that go with these.
